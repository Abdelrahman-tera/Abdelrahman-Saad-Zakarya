# ==============================================================================
# Industrial ERP for Agrochemical Manufacturing in Egypt - Environment Configuration
# ==============================================================================

# General Application Settings
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,erp.agrochemical-eg.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://erp.agrochemical-eg.com

# Timezone & Localization
DJANGO_TIME_ZONE=Africa/Cairo
DJANGO_LANGUAGE_CODE=ar-eg

# Database Configuration (PostgreSQL 16/17/18)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=agrochemical_erp
DB_USER=erp_admin
DB_PASSWORD=secure_database_password_here
DB_HOST=db
DB_PORT=5432

# Redis & Background Workers
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3 / Object Storage Configuration
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=agrochemical-erp-documents
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=eg-cairo-1

# Egyptian Tax Authority (ETA) E-Invoicing API Configuration
ETA_ENVIRONMENT=PreProduction # PreProduction or Production
ETA_CLIENT_ID=your_eta_pos_or_erp_client_id
ETA_CLIENT_SECRET=your_eta_client_secret
ETA_TOKEN_URL=https://id.preprod.eta.gov.eg/connect/token
ETA_API_BASE_URL=https://api.preprod.eta.gov.eg/api/v1.0
ETA_COMPANY_TAX_ID=100200300
ETA_ACTIVITY_CODE=2012 # Chemical and Fertilizer Manufacturing Activity Code
ETA_SIGNER_CERTIFICATE_PATH=/etc/ssl/certs/egypt_trust_cert.pfx
ETA_SIGNER_PIN=

# Document Numbering and Company Defaults
DEFAULT_COMPANY_CURRENCY=EGP
VAT_DEFAULT_RATE=0.14
WHT_SUPPLY_RATE=0.01
